# Liga o MSW (API simulada no navegador). false = usa o proxy do Vite para os serviços reais.
VITE_USE_MOCKS=true
# Prefixos usados pelo cliente HTTP (o proxy do Vite / Nginx encaminha para cada serviço)
VITE_CATALOG_API=/api/catalog
VITE_BOOKING_API=/api/booking
VITE_TICKETS_API=/api/tickets
# customerId fixo de demonstração (autenticação fora do escopo)
VITE_CUSTOMER_ID=demo-customer
# Alvos do proxy do Vite (apenas em dev)
CATALOG_URL=http://localhost:8080
BOOKING_URL=http://localhost:8081
TICKET_URL=http://localhost:8084
